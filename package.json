{
  "name": "agent-handoff",
  "version": "0.1.0",
  "description": "Context transfer protocol for multi-agent systems",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/langchain": {
      "import": "./dist/adapters/langchain.mjs",
      "require": "./dist/adapters/langchain.js",
      "types": "./dist/adapters/langchain.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/adapters/langchain.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "agent-handoff": "./dist/cli.js"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "handoff",
    "context-transfer",
    "llm",
    "ai-infrastructure"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "nanoid": "^5.0.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dabit3/agent-handoff"
  }
}
